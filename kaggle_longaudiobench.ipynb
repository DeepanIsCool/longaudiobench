   "source": [
    "# Download datasets from Hugging Face\n",
    "from datasets import load_dataset, Audio\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "DATA_DIR = Path('/kaggle/working/longaudiobench/data')\n",
    "DATA_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "def download_librispeech():\n",
    "    \"\"\"Download LibriSpeech test-clean for ANiH backgrounds + Speaker Drift\"\"\"\n",
    "    print(\"Downloading LibriSpeech test-clean...\")\n",
    "    ds = load_dataset(\"openslr/librispeech_asr\", \"clean\", split=\"test\", trust_remote_code=True)\n",
    "    ds = ds.cast_column(\"audio\", Audio(sampling_rate=16000))\n",
    "    \n",
    "    # Save metadata\n",
    "    metadata = []\n",
    "    for i, row in enumerate(ds):\n",
    "        audio_path = DATA_DIR / f\"librispeech_test_{i:05d}.wav\"\n",
    "        row[\"audio\"][\"array\"].tofile(audio_path)  # This won't work directly, need soundfile\n",
    "    \n",
    "    # Better approach: save via soundfile\n",
    "    import soundfile as sf\n",
    "    for i, row in enumerate(ds):\n",
    "        if i >= 100:  # Limit for pilot\n",
    "            break\n",
    "        audio_path = DATA_DIR / f\"librispeech_test_{i:05d}.wav\"\n",
    "        sf.write(str(audio_path), row[\"audio\"][\"array\"], 16000)\n",
    "        metadata.append({\n",
    "            \"path\": str(audio_path),\n",
    "            \"speaker_id\": row[\"speaker_id\"],\n",
    "            \"chapter_id\": row[\"chapter_id\"],\n",
    "            \"text\": row[\"text\"],\n",
    "            \"duration\": len(row[\"audio\"][\"array\"]) / 16000\n",
    "        })\n",
    "    \n",
    "    with open(DATA_DIR / \"librispeech_metadata.json\", \"w\") as f:\n",
    "        json.dump(metadata, f, indent=2)\n",
    "    print(f\"Saved {len(metadata)} LibriSpeech samples\")\n",
    "    return metadata\n",
    "\n",
    "def download_voxceleb2():\n",
    "    \"\"\"Download VoxCeleb2 dev subset for Speaker Drift\"\"\"\n",
    "    print(\"Downloading VoxCeleb2 dev...\")\n",
    "    # Use the webdataset version for streaming\n",
    "    ds = load_dataset(\"gaunernst/voxceleb2-dev-wds\", split=\"train\", streaming=True)\n",
    "    \n",
    "    import soundfile as sf\n",
    "    metadata = []\n",
    "    for i, row in enumerate(ds):\n",
    "        if i >= 200:  # Limit for pilot\n",
    "            break\n",
    "        audio_path = DATA_DIR / f\"voxceleb2_{i:05d}.wav\"\n",
    "        sf.write(str(audio_path), row[\"audio\"][\"array\"], 16000)\n",
    "        metadata.append({\n",
    "            \"path\": str(audio_path),\n",
    "            \"speaker_id\": row.get(\"speaker_id\", f\"spk_{i}\"),\n",
    "            \"duration\": len(row[\"audio\"][\"array\"]) / 16000\n",
    "        })\n",
    "    \n",
    "    with open(DATA_DIR / \"voxceleb2_metadata.json\", \"w\") as f:\n",
    "        json.dump(metadata, f, indent=2)\n",
    "    print(f\"Saved {len(metadata)} VoxCeleb2 samples\")\n",
    "    return metadata\n",
    "\n",
    "def download_freesound_needles():\n",
    "    \"\"\"Download needle sounds from Freesound dataset\"\"\"\n",
    "    print(\"Downloading Freesound needles...\")\n",
    "    # Search for specific needle types\n",
    "    needle_queries = [\n",
    "        \"glass breaking\",\n",
    "        \"pen click\",\n",
    "        \"phone notification\",\n",
    "        \"door slam\",\n",
    "        \"keyboard click\",\n",
    "        \"clock chime\",\n",
    "        \"church bell\",\n",
    "        \"train whistle\"\n",
    "    ]\n",
    "    \n",
    "    ds = load_dataset(\"Chr0my/freesound.org\", split=\"train\", streaming=True)\n",
    "    \n",
    "    import soundfile as sf\n",
    "    needles = {}\n",
    "    found = {q: False for q in needle_queries}\n",
    "    \n",
    "    for row in ds:\n",
    "        tags = row.get(\"tags\", \"\").lower()\n",
    "        desc = row.get(\"description\", \"\").lower()\n",
    "        \n",
    "        for q in needle_queries:\n",
    "            if found[q]:\n",
    "                continue\n",
    "            if q in tags or q in desc:\n",
    "                audio_path = DATA_DIR / f\"needle_{q.replace(' ', '_')}.wav\"\n",
    "                sf.write(str(audio_path), row[\"audio\"][\"array\"], 16000)\n",
    "                needles[q] = str(audio_path)\n",
    "                found[q] = True\n",
    "                print(f\"  Found: {q} -> {audio_path}\")\n",
    "                break\n",
    "        \n",
    "        if all(found.values()):\n",
    "            break\n",
    "    \n",
    "    # Fill missing with synthetic\n",
    "    import numpy as np\n",
    "    for q, found_flag in found.items():\n",
    "        if not found_flag:\n",
    "            # Generate synthetic needle\n",
    "            audio_path = DATA_DIR / f\"needle_{q.replace(' ', '_')}.wav\"\n",
    "            sr = 16000\n",
    "            t = np.linspace(0, 0.5, int(sr * 0.5))\n",
    "            if \"glass\" in q:\n",
    "                signal = np.sin(2 * np.pi * 2000 * t) * np.exp(-t * 20)  # sharp decay\n",
    "            elif \"bell\" in q or \"chime\" in q:\n",
    "                signal = np.sin(2 * np.pi * 500 * t) * np.exp(-t * 2) + np.sin(2 * np.pi * 1000 * t) * np.exp(-t * 3)\n",
    "            else:\n",
    "                signal = np.sin(2 * np.pi * 1000 * t) * np.exp(-t * 10)\n",
    "            signal = (signal * 32767).astype(np.int16)\n",
    "            sf.write(str(audio_path), signal, sr)\n",
    "            needles[q] = str(audio_path)\n",
    "            print(f\"  Synthetic: {q} -> {audio_path}\")\n",
    "    \n",
    "    return needles\n",
    "\n",
    "def download_audioset_backgrounds():\n",
    "    \"\"\"Download AudioSet backgrounds for ANiH/Soundscape\"\"\"\n",
    "    print(\"Downloading AudioSet backgrounds...\")\n",
    "    # AudioSet is large - use a subset\n",
    "    # We'll use the agkphysics/AudioSet which has parquet files\n",
    "    ds = load_dataset(\"agkphysics/AudioSet\", split=\"train\", streaming=True)\n",
    "    \n",
    "    import soundfile as sf\n",
    "    backgrounds = {\"library\": [], \"office\": [], \"lecture\": [], \"nature\": []}\n",
    "    \n",
    "    target_labels = {\n",
    "        \"library\": [\"library\", \"quiet\", \"indoor\"],\n",
    "        \"office\": [\"office\", \"typing\", \"keyboard\", \"workplace\"],\n",
    "        \"lecture\": [\"speech\", \"lecture\", \"presentation\"],\n",
    "        \"nature\": [\"rain\", \"wind\", \"bird\", \"outdoor\", \"nature\"]\n",
    "    }\n",
    "    \n",
    "    for row in ds:\n",
    "        labels = row.get(\"labels\", \"\").lower()\n",
    "        \n",
    "        for cat, keywords in target_labels.items():\n",
    "            if len(backgrounds[cat]) >= 10:\n",
    "                continue\n",
    "            if any(kw in labels for kw in keywords):\n",
    "                audio_path = DATA_DIR / f\"bg_{cat}_{len(backgrounds[cat])}.wav\"\n",
    "                sf.write(str(audio_path), row[\"audio\"][\"array\"], 16000)\n",
    "                backgrounds[cat].append(str(audio_path))\n",
    "                print(f\"  {cat}: {audio_path}\")\n",
    "                break\n",
    "        \n",
    "        if all(len(v) >= 10 for v in backgrounds.values()):\n",
    "            break\n",
    "    \n",
    "    # Fill missing with synthetic\n",
    "    import numpy as np\n",
    "    for cat in backgrounds:\n",
    "        while len(backgrounds[cat]) < 10:\n",
    "            audio_path = DATA_DIR / f\"bg_{cat}_{len(backgrounds[cat])}.wav\"\n",
    "            sr = 16000\n",
    "            t = np.linspace(0, 30, sr * 30)  # 30 sec clips\n",
    "            if cat == \"nature\":\n",
    "                signal = np.random.randn(len(t)) * 0.1  # pink noise approx\n",
    "            else:\n",
    "                signal = np.random.randn(len(t)) * 0.05\n",
    "            signal = (signal * 32767).astype(np.int16)\n",
    "            sf.write(str(audio_path), signal, sr)\n",
    "            backgrounds[cat].append(str(audio_path))\n",
    "    \n",
    "    return backgrounds\n",
    "\n",
    "# Run downloads\n",
    "print(\"=\"*50)\n",
    "print(\"DOWNLOADING DATASETS\")\n",
    "print(\"=\"*50)\n",
    "\n",
    "librispeech_meta = download_librispeech()\n",
    "voxceleb2_meta = download_voxceleb2()\n",
    "needles = download_freesound_needles()\n",
    "backgrounds = download_audioset_backgrounds()\n",
    "\n",
    "# Save combined metadata\n",
    "all_metadata = {\n",
    "    \"librispeech\": librispeech_meta,\n",
    "    \"voxceleb2\": voxceleb2_meta,\n",
    "    \"needles\": needles,\n",
    "    \"backgrounds\": backgrounds,\n",
    "}\n",
    "with open(DATA_DIR / \"all_metadata.json\", \"w\") as f:\n",
    "    json.dump(all_metadata, f, indent=2)\n",
    "\n",
    "print(\"\\n✓ All datasets downloaded\")"
   ]
  },

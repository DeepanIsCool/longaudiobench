    "# Aggregate and analyze results\n",
    "import json\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "RESULTS_DIR = Path('/kaggle/working/longaudiobench/results')\n",
    "\n",
    "def load_summary(path):\n",
    "    if path.exists():\n",
    "        with open(path, 'r') as f:\n",
    "            return json.load(f)\n",
    "    return {}\n",
    "\n",
    "cascaded = load_summary(RESULTS_DIR / \"cascaded_summary.json\")\n",
    "salmonn = load_summary(RESULTS_DIR / \"salmonn_summary.json\")\n",
    "qwen = load_summary(RESULTS_DIR / \"qwen2_audio_summary.json\")\n",
    "\n",
    "all_results = {\n",
    "    \"whisper_llama3\": cascaded,\n",
    "    \"salmonn\": salmonn,\n",
    "    \"qwen2_audio\": qwen,\n",
    "}\n",
    "\n",
    "# Primary metrics per task\n",
    "PRIMARY_METRICS = {\n",
    "    \"anih\": \"composite_score\",\n",
    "    \"speaker_drift\": \"joint_accuracy\",\n",
    "    \"soundscape\": \"composite_score\",\n",
    "    \"narrative_coherence\": \"composite_score\",\n",
    "}\n",
    "\n",
    "# Create main results table\n",
    "rows = []\n",
    "for model_name, model_results in all_results.items():\n",
    "    row = {\"Model\": model_name}\n",
    "    for task_name in [\"anih\", \"speaker_drift\", \"soundscape\", \"narrative_coherence\"]:\n",
    "        if task_name in model_results:\n",
    "            metric = PRIMARY_METRICS.get(task_name, \"composite_score\")\n",
    "            val = model_results[task_name][\"metrics\"].get(metric, {}).get(\"mean\", 0)\n",
    "            row[task_name.replace('_', ' ').title()] = f\"{val:.3f}\"\n",
    "        else:\n",
    "            row[task_name.replace('_', ' ').title()] = \"N/A\"\n",
    "    rows.append(row)\n",
    "\n",
    "df = pd.DataFrame(rows)\n",
    "print(\"\\n\" + \"=\"*60)\n",
    print(\"MAIN RESULTS TABLE\")\n",
    print(\"=\"*60)\n",
    print(df.to_string(index=False))\n",

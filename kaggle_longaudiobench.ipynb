   "source": [
    "# Run evaluation - Whisper + Llama-3 (Cascaded)\n",
    "import torch\n",
    "print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n",
    "print(f\"VRAM: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB\")\n",
    "\n",
    "from longaudiobench.tasks import get_task, list_tasks\n",
    "from longaudiobench.baselines import get_baseline, ModelConfig\n",
    "from longaudiobench.tasks.base import TaskInstance\n",
    "from longaudiobench.metrics import compute_task_metrics\n",
    "import json\n",
    "import time\n",
    "from pathlib import Path\n",
    "\n",
    "GEN_DIR = Path('/kaggle/working/longaudiobench/data/generated')\n",
    "RESULTS_DIR = Path('/kaggle/working/longaudiobench/results')\n",
    "RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "def load_instances(task_name, split=\"test\"):\n",
    "    path = GEN_DIR / f\"{task_name}_{split}.jsonl\"\n",
    "    instances = []\n",
    "    with open(path, 'r') as f:\n",
    "        for line in f:\n",
    "            data = json.loads(line.strip())\n",
    "            instances.append(TaskInstance(**data))\n",
    "    return instances\n",
    "\n",
    "def run_model_on_task(model_name, model_config_dict, task_name, instances):\n",
    "    print(f\"\\n{'='*50}\")\n",
    "    print(f\"Evaluating {model_name} on {task_name}\")\n",
    "    print(f\"{'='*50}\")\n",
    "    \n",
    "    task = get_task(task_name)\n",
    "    model_config = ModelConfig(name=model_name, **model_config_dict)\n",
    "    baseline = get_baseline(model_name, model_config)\n",
    "    \n",
    "    # Load model with 4-bit quantization for memory\n",
    "    print(\"Loading model...\")\n",
    "    try:\n",
    "        baseline.load_model()\n",
    "    except Exception as e:\n",
    "        print(f\"Failed to load {model_name}: {e}\")\n",
    "        return None\n",
    "    \n",
    "    predictions = []\n",
    "    latencies = []\n",
    "    \n",
    "    for i, instance in enumerate(instances):\n",
    "        print(f\"  [{i+1}/{len(instances)}] {instance.instance_id}\")\n",
    "        start = time.time()\n",
    "        try:\n",
    "            result = baseline.predict(instance.audio_path, instance.prompt)\n",
    "            latency = (time.time() - start) * 1000\n",
    "            parsed = task.parse_model_response(result.get(\"response\", \"\"))\n",
    "            predictions.append({\n",
    "                \"instance_id\": instance.instance_id,\n",
    "                \"prediction\": parsed,\n",
    "                \"raw_response\": result.get(\"response\", \"\"),\n",
    "                \"latency_ms\": latency,\n",
    "            })\n",
    "            latencies.append(latency)\n",
    "        except Exception as e:\n",
    "            print(f\"    ERROR: {e}\")\n",
    "            predictions.append({\n",
    "                \"instance_id\": instance.instance_id,\n",
    "                \"prediction\": {},\n",
    "                \"raw_response\": f\"ERROR: {e}\",\n",
    "                \"latency_ms\": -1,\n",
    "            })\n",
    "            latencies.append(-1)\n",
    "        \n",
    "        # Clear cache periodically\n",
    "        if i % 2 == 0:\n",
    "            torch.cuda.empty_cache()\n",
    "    \n",
    "    # Evaluate\n",
    "    ground_truths = [inst.ground_truth for inst in instances]\n",
    "    eval_results = compute_task_metrics(\n",
    "        task_name,\n",
    "        [p[\"prediction\"] for p in predictions],\n",
    "        ground_truths,\n",
    "        task.evaluate\n",
    "    )\n",
    "    \n",
    "    results = {\n",
    "        \"task\": task_name,\n",
    "        \"model\": model_name,\n",
    "        \"num_instances\": len(instances),\n",
    "        \"metrics\": eval_results,\n",
    "        \"avg_latency_ms\": sum(l for l in latencies if l > 0) / len([l for l in latencies if l > 0]) if any(l > 0 for l in latencies) else 0,\n",
    "        \"predictions\": predictions,\n",
    "    }\n",
    "    \n",
    "    # Save\n",
    "    out_path = RESULTS_DIR / f\"{task_name}_{model_name}_results.json\"\n",
    "    with open(out_path, 'w') as f:\n",
    "        json.dump(results, f, indent=2)\n",
    "    \n",
    "    print(f\"Results: {eval_results}\")\n",
    "    print(f\"Avg latency: {results['avg_latency_ms']:.0f} ms\")\n",
    "    \n",
    "    # Cleanup\n",
    "    del baseline\n",
    "    torch.cuda.empty_cache()\n",
    "    \n",
    "    return results\n",
    "\n",
    "# Load instances\n",
    "all_instances = {}\n",
    "for task_name in list_tasks():\n",
    "    try:\n",
    "        all_instances[task_name] = load_instances(task_name)\n",
    "        print(f\"Loaded {len(all_instances[task_name])} instances for {task_name}\")\n",
    "    except Exception as e:\n",
    "        print(f\"Failed to load {task_name}: {e}\")\n",
    "\n",
    "# Run cascaded baseline (Whisper + Llama-3)\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"RUNNING CASCADED BASELINE: Whisper-large-v3 + Llama-3-8B\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "cascaded_results = {}\n",
    "for task_name, instances in all_instances.items():\n",

    "        \"whisper_llama3\",\n",
    "        MODEL_CONFIGS[\"whisper_llama3\"],\n",
    "        task_name,\n",
    "        instances\n",
    "    )\n",
    "    if res:\n",
    "        cascaded_results[task_name] = res\n",
    "\n",
    "# Save cascaded summary\n",
    "with open(RESULTS_DIR / \"cascaded_summary.json\", 'w') as f:\n",
    "    json.dump(cascaded_results, f, indent=2)\n",
    "\n",
    "print(\"\\n✓ Cascaded baseline complete\")"

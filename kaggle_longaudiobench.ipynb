   "source": [
    "# Generate task instances\n",
    "import sys\n",
    "sys.path.insert(0, '/kaggle/working/longaudiobench')\n",
    "\n",
    "from longaudiobench.tasks import get_task\n",
    "from longaudiobench.data.audio_mixing import (\n",
    "    create_anih_audio,\n",
    "    create_speaker_drift_audio,\n",
    "    create_soundscape_audio,\n",
    "    create_narrative_coherence_audio,\n",
    ")\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "DATA_DIR = Path('/kaggle/working/longaudiobench/data')\n",
    "GEN_DIR = DATA_DIR / 'generated'\n",
    "GEN_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "with open(DATA_DIR / \"all_metadata.json\", \"r\") as f:\n",
    "    meta = json.load(f)\n",
    "\n",
    "# Prepare source data for task generation\n",
    "source_data = {\n",
    "    \"background_audio_paths\": meta[\"backgrounds\"],\n",
    "    \"needle_audio_paths\": meta[\"needles\"],\n",
    "    \"speaker_audio_paths\": {\n",
    "        \"librispeech\": meta[\"librispeech\"],\n",
    "        \"voxceleb2\": meta[\"voxceleb2\"],\n",
    "    },\n",
    "    \"event_audio_paths\": meta[\"backgrounds\"],  # reuse for soundscapes\n",
    "    \"acoustic_clue_paths\": meta[\"needles\"],\n",
    "    \"story_audio_paths\": meta[\"librispeech\"][:20],  # use first 20 as stories\n",
    "}\n",
    "\n",
    "# Generate instances for each task (small pilot: 5 per task)\n",
    "NUM_PER_TASK = 5\n",
    "\n",
    "for task_name in [\"anih\", \"speaker_drift\", \"soundscape\", \"narrative_coherence\"]:\n",
    "    print(f\"\\nGenerating {task_name} instances...\")\n",
    "    task = get_task(task_name)\n",
    "    instances = task.generate_instances(source_data, NUM_PER_TASK, split=\"test\")\n    \n",
    "    # Actually create the audio files\n",
    "    for inst in instances:\n",
    "        try:\n",
    "            if task_name == \"anih\":\n",
    "                create_anih_audio(\n",
    "                    inst.metadata[\"bg_audio_path\"],\n",
    "                    inst.metadata[\"needle_audio_path\"],\n",
    "                    inst.audio_path,\n",
    "                    inst.metadata[\"insertion_time\"],\n",
    "                    bg_duration=300,  # 5 min for pilot\n",
    "                    snr_db=10.0\n",
    "                )\n",
    "            elif task_name == \"speaker_drift\":\n",
    "                # Build speaker segments from metadata\n",
    "                segments = []\n",
    "                for seg in inst.metadata[\"timeline\"]:\n",
    "                    spk_meta = inst.metadata[\"selected_speakers\"][seg[\"speaker_idx\"]]\n",
    "                    segments.append((spk_meta[\"audio_path\"], seg[\"start_time\"], seg[\"end_time\"]))\n",
    "                create_speaker_drift_audio(segments, inst.audio_path, total_duration=300)\n",
    "            elif task_name == \"soundscape\":\n",
    "                # Build event segments\n",
    "                segments = []\n",
    "                for ev in inst.metadata[\"events\"]:\n",
    "                    # Find matching audio file\n",
    "                    for bg_cat, paths in meta[\"backgrounds\"].items():\n",
    "                        if paths:\n",
    "                            segments.append((paths[0], \n",
    "                                           int(ev[\"start\"].split(':')[0])*60 + int(ev[\"start\"].split(':')[1]),\n",
    "                                           int(ev[\"end\"].split(':')[0])*60 + int(ev[\"end\"].split(':')[1]) if ev[\"end\"] != \"ongoing\" else 300))\n",
    "                            break\n",
    "                create_soundscape_audio(segments, meta[\"backgrounds\"][\"nature\"][0], \n",
    "                                      inst.audio_path, total_duration=300)\n",
    "            elif task_name == \"narrative_coherence\":\n",
    "                create_narrative_coherence_audio(\n",
    "                    inst.metadata[\"story_path\"],\n",
    "                    inst.metadata[\"clue_audio_path\"],\n",
    "                    inst.audio_path,\n",
    "                    inst.metadata[\"clue_a_time\"],\n",
    "                    story_duration=300\n",
    "                )\n",
    "        except Exception as e:\n",
    "            print(f\"  Failed to create audio for {inst.instance_id}: {e}\")\n",
    "    \n",
    "    # Save instances\n",
    "    task.save_instances(instances, str(GEN_DIR / f\"{task_name}_test.jsonl\"))\n",
    "    print(f\"  Saved {len(instances)} instances\")\n",
    "\n",
    "print(\"\\n✓ All task instances generated\")"
   ]
  },
